{
  "name": "sng-whatsapp",
  "version": "1.0.0",
  "description": "Inicializador do frontend e backend do SNG Chat",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "build": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run dev",
    "clear-database": "npm --prefix backend run clear-database",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
