MONGODB_URI=mongodb://127.0.0.1:27017/sng_whatsapp
PORT=3000

# Use production apenas no servidor publicado por HTTPS.
# NODE_ENV=production

# Sincronizacao do historico do WhatsApp.
HISTORY_SYNC_DAYS=30
HISTORY_SYNC_LIMIT=1000
HISTORY_SYNC_MEDIA=true

# Integração com o GLPI. Estes valores devem existir somente no backend.
GLPI_URL=https://atendimento.sng.com.br/apirest.php
SD_APP_TOKEN=substitua_pelo_app_token_do_glpi
SD_USER_TOKEN=substitua_pelo_user_token_do_glpi
# Limite preventivo por anexo enviado pelo backend (também depende do limite do PHP/GLPI).
GLPI_MAX_ATTACHMENT_MB=25
