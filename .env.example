MONGODB_URI=mongodb://127.0.0.1:27017/sng_whatsapp
PORT=3000
PANEL_ORIGINS=https://whatsapp.sng.com.br
SESSION_DURATION_HOURS=12

# Desative depois que todas as integracoes usarem API clients individuais.
ALLOW_LEGACY_MASTER_KEY=true

# Use production apenas no servidor publicado por HTTPS.
# NODE_ENV=production

# Mantenha false/ausente. Use true somente em ambiente isolado que não suporte o sandbox do Chromium.
# CHROMIUM_DISABLE_SANDBOX=false

# Sincronizacao do historico do WhatsApp.
HISTORY_SYNC_DAYS=30
HISTORY_SYNC_LIMIT=1000
HISTORY_SYNC_MEDIA=true

# Tamanho maximo de arquivos enviados pelo painel/API multipart (em MiB).
MAX_UPLOAD_MB=50

# Protege /api/health/metrics. Se ausente, o endpoint responde 404.
METRICS_TOKEN=substitua_por_um_token_longo_e_aleatorio

# Integração com o GLPI. Estes valores devem existir somente no backend.
GLPI_URL=https://atendimento.sng.com.br/apirest.php
SD_APP_TOKEN=substitua_pelo_app_token_do_glpi
SD_USER_TOKEN=substitua_pelo_user_token_do_glpi
# Limite preventivo por anexo enviado pelo backend (também depende do limite do PHP/GLPI).
GLPI_MAX_ATTACHMENT_MB=25

# Servidor SMTP usado para enviar codigos de recuperacao de senha.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=usuario@empresa.com.br
SMTP_PASSWORD=substitua_pela_senha_ou_senha_de_aplicativo
SMTP_FROM="SNG WhatsApp <usuario@empresa.com.br>"
